---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  float?: 'left' | 'right';
  caption?: string;
  marker?: number;
}

const { src, alt, width, float, caption, marker } = Astro.props;
const aspectRatio = src.height / src.width;
const resolvedWidth = width ?? src.width;
const resolvedHeight = width ? Math.round(width * aspectRatio) : src.height;
---

<figure
  id={marker ? `figure-${marker}` : undefined}
  class:list={['article-figure', 'lightbox-figure', float && `article-figure--${float}`]}
  style={width ? `width: ${width}px` : undefined}
>
  <Image
    {src}
    {alt}
    width={resolvedWidth}
    height={resolvedHeight}
    class="lightbox-trigger"
  />
  {(caption || marker) && (
    <figcaption>
      {caption}{marker && <sup><a href={`#credit-${marker}`}>{marker}</a></sup>}
    </figcaption>
  )}
</figure>

<div class="lightbox-overlay" role="dialog" aria-modal="true" aria-label={alt}>
  <button class="lightbox-close" aria-label="Close image">✕</button>
  <Image
    {src}
    {alt}
    width={1600}
    height={Math.round(1600 * aspectRatio)}
    class="lightbox-full"
  />
  {caption && <p class="lightbox-caption">{caption}</p>}
</div>

<script>
  const figures = document.querySelectorAll('.lightbox-figure');

  figures.forEach((figure) => {
    const trigger = figure.querySelector('.lightbox-trigger');
    const overlay = figure.nextElementSibling as HTMLElement;
    const closeBtn = overlay?.querySelector('.lightbox-close');

    trigger?.addEventListener('click', () => {
      overlay?.classList.add('lightbox-open');
      document.body.style.overflow = 'hidden';
    });

    closeBtn?.addEventListener('click', () => {
      overlay?.classList.remove('lightbox-open');
      document.body.style.overflow = '';
    });

    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) {
        overlay.classList.remove('lightbox-open');
        document.body.style.overflow = '';
      }
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.lightbox-overlay.lightbox-open').forEach((overlay) => {
        (overlay as HTMLElement).classList.remove('lightbox-open');
        document.body.style.overflow = '';
      });
    }
  });
</script>